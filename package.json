{
  "name": "homebridge-skyworth-airton",
  "displayName": "Homebridge Skyworth Airton",
  "version": "1.0.0",
  "description": "Local HomeKit control for Skyworth and Airton Wi-Fi air conditioners.",
  "author": "trcm",
  "homepage": "https://github.com/tomtastic/homebridge-skyworth-airton#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomtastic/homebridge-skyworth-airton.git"
  },
  "bugs": {
    "url": "https://github.com/tomtastic/homebridge-skyworth-airton/issues"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "skyworth",
    "airton",
    "air-conditioner"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "PROVISIONING_PROTOCOL.md",
    "skyworth_provision.py"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.9.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "npm run build && node --test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.12.0",
    "eslint": "^10.9.0",
    "globals": "^17.14.0",
    "homebridge": "^2.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
